{
  "name": "vinylmatrix-card",
  "version": "0.2.0",
  "private": true,
  "description": "An animated turntable music card for Home Assistant",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node tests/player.test.mjs && node tests/branding.test.mjs",
