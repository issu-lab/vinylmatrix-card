    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": { "lit": "3.3.3" },
  "devDependencies": { "typescript": "5.9.3", "vite": "7.3.6", "playwright": "1.62.1" }
